<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>每句练耳</title>

<style>
body{
    margin:0;
    padding:30px 15px;
    background:#f5f5f5;
    font-family:-apple-system,BlinkMacSystemFont,
    "Microsoft YaHei",Arial,sans-serif;
}

.card{
    max-width:560px;
    margin:auto;
    background:white;
    padding:25px 18px 30px;
    border-radius:22px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
    text-align:center;
}

h1{
    margin:0;
    font-size:28px;
}

.english{
    margin-top:35px;
    font-size:30px;
    font-weight:bold;
}

.chinese{
    margin-top:15px;
    font-size:20px;
    color:#666;
}

audio{
    width:100%;
    margin-top:30px;
}

button{
    width:100%;
    border:0;
    border-radius:12px;
    padding:15px;
    margin-top:12px;
    font-size:18px;
}

.play{
    background:#222;
    color:white;
}

.nav{
    display:flex;
    gap:10px;
}

.nav button{
    background:#eee;
}

#status{
    margin-top:15px;
    color:#777;
    min-height:24px;
}
</style>
</head>

<body>

<div class="card">

<h1>🎧 每句练耳</h1>

<div class="english" id="english">
Good morning.
</div>

<div class="chinese" id="chinese">
早上好。
</div>

<audio
    id="player"
    controls
    preload="metadata"
    playsinline>
</audio>

<button
    class="play"
    onclick="playSentence()">
▶ 播放英语
</button>

<div class="nav">

<button onclick="previousSentence()">
⬅ 上一句
</button>

<button onclick="nextSentence()">
下一句 ➡
</button>

</div>

<div id="status">
准备好了
</div>

</div>


<script>

/* =========================
   句库
========================= */

const lessons = [

    ["Good morning.","早上好。"],

    ["How are you?","你好吗？"],

    ["What are you doing?","你在做什么？"],

    ["Where are you going?","你要去哪里？"],

    ["Where do you live?","你住在哪里？"]

];


/* 当前句 */

let current = 0;


/* 播放器 */

const player =
    document.getElementById("player");


/* =========================
   显示句子
========================= */

function showSentence(){

    document.getElementById("english")
        .innerText =
        lessons[current][0];

    document.getElementById("chinese")
        .innerText =
        lessons[current][1];

}


/* =========================
   播放 MP3
========================= */

function playSentence(){

    /* 先停止旧音频 */

    player.pause();

    player.currentTime = 0;


    /* 生成文件名

       第1句 = 001.mp3
       第2句 = 002.mp3
       第3句 = 003.mp3
    */

    const number =
        String(current + 1)
        .padStart(3,"0");


    const audioFile =
        "audio/" +
        number +
        ".mp3";


    /* 设置音频 */

    player.src = audioFile;

    player.load();


    document.getElementById("status")
        .innerText =
        "🎧 正在读取 " +
        number +
        ".mp3";


    /* 播放 */

    player.play()

        .then(function(){

            document.getElementById("status")
                .innerText =
                "🎧 正在播放……";

        })

        .catch(function(error){

            console.log(error);

            document.getElementById("status")
                .innerText =
                "⚠️ 播放失败，请检查 " +
                number +
                ".mp3";

        });

}


/* =========================
   下一句
========================= */

function nextSentence(){

    player.pause();

    player.currentTime = 0;

    current++;

    if(current >= lessons.length){

        current = 0;

    }

    showSentence();

    document.getElementById("status")
        .innerText =
        "准备好了";

}


/* =========================
   上一句
========================= */

function previousSentence(){

    player.pause();

    player.currentTime = 0;

    current--;

    if(current < 0){

        current =
            lessons.length - 1;

    }

    showSentence();

    document.getElementById("status")
        .innerText =
        "准备好了";

}


/* =========================
   播放结束
========================= */

player.addEventListener(
    "ended",
    function(){

        document.getElementById("status")
            .innerText =
            "✅ 播放完成";

    }
);


/* =========================
   播放错误
========================= */

player.addEventListener(
    "error",
    function(){

        document.getElementById("status")
            .innerText =
            "❌ 音频文件读取失败";

    }
);


/* =========================
   初始化
========================= */

showSentence();

</script>

</body>
</html>