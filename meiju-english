<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>每句练耳 · 英语学习版</title>
<style>
/* ===== 样式 ===== */
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{margin:0;padding:20px 14px 40px;background:#f5f7fa;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei",Arial,sans-serif;color:#1e293b;min-height:100vh;}
.container{max-width:560px;width:100%;margin:0 auto;}
.header{text-align:center;padding:6px 0 20px;}
.header h1{margin:0;font-size:30px;font-weight:700;}
.header p{margin:6px 0 0;color:#94a3b8;font-size:15px;}
.card{background:#fff;border-radius:24px;padding:26px 20px 22px;box-shadow:0 8px 30px rgba(0,0,0,.06);text-align:center;}
.scene{color:#94a3b8;font-size:14px;font-weight:500;}
.progress{color:#b9c2d0;margin-top:4px;font-size:14px;}
.english{font-size:30px;font-weight:700;color:#0f172a;margin:12px 0;min-height:60px;}
.chinese{font-size:22px;color:#475569;margin-bottom:12px;}
.replace-title{margin-top:16px;font-size:13px;color:#94a3b8;}
.replace-list{display:flex;flex-wrap:wrap;justify-content:center;gap:7px;margin-top:8px;}
.replace-item{cursor:pointer;padding:7px 10px;background:#f1f4f9;border-radius:10px;font-size:14px;color:#334155;transition:background 0.2s;}
.replace-item:hover{background:#d1d9e6;}
.player-controls{display:flex;align-items:center;justify-content:center;gap:20px;margin:20px 0 10px;}
.ctrl-btn{background:#f1f4f9;border:0;padding:0;cursor:pointer;font-size:32px;color:#1e293b;width:60px;height:60px;display:flex;align-items:center;justify-content:center;border-radius:50%;touch-action:manipulation;}
.ctrl-btn:active{transform:scale(.90);}
.ctrl-btn.play-btn{width:80px;height:80px;font-size:40px;background:#1e293b;color:#fff;}
.extra-buttons{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;}
.extra-buttons button{flex:1 1 auto;min-width:75px;padding:10px 12px;border:0;border-radius:14px;font-size:14px;font-weight:600;cursor:pointer;background:#f1f4f9;color:#1e293b;}
.status{min-height:28px;margin-top:12px;color:#94a3b8;font-size:14px;}
.status.speaking{color:#3b82f6;}
.status.done{color:#22c55e;}
@media(max-width:480px){.english{font-size:25px;}.ctrl-btn{width:50px;height:50px;font-size:28px;}.ctrl-btn.play-btn{width:70px;height:70px;font-size:36px;}}
</style>
</head>
<body>
<div class="container">
<div class="header">
<h1>🎧 每句练耳</h1>
<p>听清 · 听懂 · 开口</p>
</div>
<div class="card">
<div id="scene" class="scene">日常</div>
<div id="progress" class="progress">第 1 / 20 句</div>
<div id="english" class="english">Good morning.</div>
<div id="chinese" class="chinese">早上好。</div>
<div class="replace-title">替换练习</div>
<div id="replaceList" class="replace-list"></div>
<div class="player-controls">
<button class="ctrl-btn" onclick="prevTrack()">⏮</button>
<button id="playPauseBtn" class="ctrl-btn play-btn" onclick="togglePlayPause()">▶</button>
<button class="ctrl-btn" onclick="nextTrack()">⏭</button>
</div>
<div class="extra-buttons">
<button onclick="toggleRepeat()">🔁 复读</button>
<button onclick="randomSentence()">🎲 随机</button>
</div>
<div id="status" class="status">准备好了</div>
</div>
</div>
<script>
// 简单的语块数据（您可扩展至1300条）
const lessons = [
{scene:"日常",en:"Good morning.",cn:"早上好。",replace:["morning","afternoon","evening","night","day"]},
{scene:"日常",en:"How are you?",cn:"你好吗？",replace:["you","everyone","they","we","all"]},
{scene:"日常",en:"What are you doing?",cn:"你在做什么？",replace:["doing","saying","thinking","feeling","wanting"]},
{scene:"日常",en:"I love you.",cn:"我爱你。",replace:["love","like","need","want","miss"]},
{scene:"日常",en:"Thank you very much.",cn:"非常感谢。",replace:["very much","so much","a lot","sincerely","deeply"]},
{scene:"日常",en:"Excuse me.",cn:"打扰一下。",replace:["me","us","them","her","him"]},
{scene:"日常",en:"I don't understand.",cn:"我不明白。",replace:["understand","know","see","get","follow"]},
{scene:"日常",en:"Could you help me?",cn:"你能帮我吗？",replace:["help","tell","show","give","teach"]},
];
// 扩展至20句（循环填充）
while(lessons.length < 20){
    const b = lessons[lessons.length % lessons.length];
    lessons.push({scene:b.scene,en:b.en+"?",cn:b.cn+"吗？",replace:b.replace.map(r=>r+"?")});
}
let currentIndex = 0, isSpeaking = false, utt = null, isRepeating = false, repeatCount = 0, repeatTimer = null;
const dom = {scene:document.getElementById("scene"),progress:document.getElementById("progress"),english:document.getElementById("english"),chinese:document.getElementById("chinese"),replaceList:document.getElementById("replaceList"),status:document.getElementById("status"),playPauseBtn:document.getElementById("playPauseBtn")};
function getItem(){return lessons[currentIndex]||null;}
function stopSpeech(){if(utt){try{window.speechSynthesis.cancel();}catch(e){}utt=null;}isSpeaking=false;dom.playPauseBtn.textContent="▶";dom.playPauseBtn.classList.remove("paused");}
function speakText(text,cb){if(!window.speechSynthesis||!window.SpeechSynthesisUtterance){dom.status.textContent="⚠️ 不支持语音";return;}const utterance=new SpeechSynthesisUtterance(text);utt=utterance;utterance.lang='en-US';utterance.rate=0.7;utterance.pitch=1.1;utterance.volume=1;let ended=false;utterance.onstart=function(){if(utt!==utterance)return;isSpeaking=true;dom.playPauseBtn.textContent="⏸";dom.playPauseBtn.classList.add("paused");dom.status.textContent="🎧 播放中";dom.status.className="status speaking";};utterance.onend=function(){if(ended)return;ended=true;isSpeaking=false;utt=null;dom.playPauseBtn.textContent="▶";dom.playPauseBtn.classList.remove("paused");dom.status.textContent="✅ 播放完成";dom.status.className="status done";if(cb)cb(true);};utterance.onerror=function(){if(ended)return;ended=true;isSpeaking=false;utt=null;dom.playPauseBtn.textContent="▶";dom.playPauseBtn.classList.remove("paused");dom.status.textContent="⚠️ 播放失败";dom.status.className="status error";if(cb)cb(false);};try{window.speechSynthesis.speak(utterance);}catch(e){dom.status.textContent="⚠️ 异常";}}
function playCurrent(){if(isSpeaking){stopSpeech();setTimeout(playCurrent,200);return;}const item=getItem();if(!item)return;dom.status.textContent="⏳ 加载中...";dom.status.className="status";speakText(item.en);}
function togglePlayPause(){if(isSpeaking){stopSpeech();dom.status.textContent="⏸ 已暂停";dom.status.className="status";}else{playCurrent();}}
function prevTrack(){stopSpeech();currentIndex=(currentIndex-1+lessons.length)%lessons.length;showSentence();setTimeout(playCurrent,150);}
function nextTrack(){stopSpeech();currentIndex=(currentIndex+1)%lessons.length;showSentence();setTimeout(playCurrent,150);}
function randomSentence(){stopSpeech();currentIndex=Math.floor(Math.random()*lessons.length);showSentence();setTimeout(playCurrent,150);}
function toggleRepeat(){if(isRepeating){isRepeating=false;clearTimeout(repeatTimer);stopSpeech();dom.status.textContent="⏸ 已停止复读";return;}isRepeating=true;repeatCount=0;dom.status.textContent=`🔁 复读 1/5`;dom.status.className="status";doRepeat();}
function doRepeat(){if(!isRepeating)return;repeatCount++;dom.status.textContent=`🔁 复读 ${repeatCount}/5`;dom.status.className="status";const item=getItem();if(!item){stopSpeech();return;}speakText(item.en,function(success){if(!isRepeating)return;if(!success){isRepeating=false;dom.status.textContent="⚠️ 中断";return;}if(repeatCount>=5){isRepeating=false;dom.status.textContent="✅ 复读完成";dom.status.className="status done";return;}repeatTimer=setTimeout(doRepeat,600);});}
function playReplaceWord(word){if(!word)return;speakText(word);}
function showSentence(){const item=getItem();if(!item)return;dom.scene.textContent=item.scene;dom.progress.textContent=`第 ${currentIndex+1} / ${lessons.length} 句`;dom.english.textContent=item.en;dom.chinese.textContent=item.cn;dom.replaceList.innerHTML="";(item.replace||[]).forEach(function(w){const s=document.createElement("span");s.className="replace-item";s.textContent=w;s.style.cursor="pointer";s.onclick=function(){playReplaceWord(w);};dom.replaceList.appendChild(s);});dom.status.textContent="准备好了";dom.status.className="status";}
// 键盘事件
document.addEventListener("keydown",function(e){if(e.key==="ArrowLeft"){e.preventDefault();prevTrack();}if(e.key==="ArrowRight"){e.preventDefault();nextTrack();}if(e.key===" "){e.preventDefault();togglePlayPause();}if(e.key==="r"||e.key==="R"){e.preventDefault();toggleRepeat();}});
// 初始化
if(window.speechSynthesis){window.speechSynthesis.getVoices();window.speechSynthesis.onvoiceschanged=function(){window.speechSynthesis.getVoices();};}
showSentence();
console.log('🎧 每句练耳 已加载');
</script>
</body>
</html>