<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>每句练耳</title>

<style>
*{box-sizing:border-box}

body{
    margin:0;
    padding:20px 14px 40px;
    background:#f5f5f5;
    font-family:-apple-system,BlinkMacSystemFont,
    "Microsoft YaHei",Arial,sans-serif;
}

.container{
    max-width:560px;
    margin:auto;
}

h1{
    text-align:center;
    margin:10px 0 5px;
}

.subtitle{
    text-align:center;
    color:#888;
    margin-bottom:20px;
}

.search{
    display:flex;
    gap:8px;
    margin-bottom:15px;
}

.search input{
    flex:1;
    min-width:0;
    padding:13px;
    border:1px solid #ddd;
    border-radius:12px;
    font-size:16px;
}

.search button{
    width:auto;
    margin:0;
    background:#222;
    color:white;
}

.results{
    margin-bottom:15px;
}

.result{
    background:white;
    padding:13px;
    margin-bottom:8px;
    border-radius:12px;
}

.result-en{
    font-weight:bold;
}

.result-cn{
    margin-top:5px;
    color:#777;
}

.card{
    background:white;
    border-radius:22px;
    padding:25px 18px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
    text-align:center;
}

.scene{
    color:#888;
    font-size:14px;
}

.progress{
    color:#aaa;
    margin-top:6px;
    font-size:14px;
}

.english{
    min-height:100px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
    font-weight:bold;
    line-height:1.4;
}

.chinese{
    min-height:45px;
    font-size:20px;
    color:#666;
}

audio{
    width:100%;
    margin-top:20px;
}

button{
    width:100%;
    border:0;
    border-radius:12px;
    padding:14px;
    margin-top:10px;
    font-size:17px;
}

.play{
    background:#222;
    color:white;
}

.normal{
    background:#eee;
}

.nav{
    display:flex;
    gap:8px;
}

.status{
    min-height:24px;
    margin-top:15px;
    color:#777;
    font-size:14px;
}
</style>
</head>

<body>

<div class="container">

<h1>🎧 每句练耳</h1>

<div class="subtitle">
听清 · 听懂 · 开口
</div>


<!-- 搜索 -->

<div class="search">

<input
id="searchInput"
type="search"
placeholder="输入中文或英文"
>

<button onclick="searchSentence()">
搜索
</button>

</div>

<div id="results" class="results"></div>


<!-- 句子 -->

<div class="card">

<div id="scene" class="scene">
日常
</div>

<div id="progress" class="progress">
第 1 / 5 句
</div>

<div id="english" class="english">
Good morning.
</div>

<div id="chinese" class="chinese">
早上好。
</div>


<!-- MP3播放器 -->

<audio
id="player"
controls
preload="metadata"
playsinline>
</audio>


<button
class="play"
onclick="playCurrent()">
▶ 播放英语
</button>


<button
class="normal"
onclick="repeatCurrent()">
🔁 重听
</button>


<div class="nav">

<button
class="normal"
onclick="previousSentence()">
⬅ 上一句
</button>

<button
class="normal"
onclick="nextSentence()">
下一句 ➡
</button>

</div>


<button
class="normal"
onclick="randomSentence()">
🎲 随机一句
</button>


<div
id="status"
class="status">
准备好了
</div>

</div>

</div>


<script>

/* =========================
   5句测试
========================= */

const lessons = [

{
scene:"日常",
en:"Good morning.",
cn:"早上好。",
audio:"001.mp3"
},

{
scene:"日常",
en:"How are you?",
cn:"你好吗？",
audio:"002.mp3"
},

{
scene:"日常",
en:"What are you doing?",
cn:"你在做什么？",
audio:"003.mp3"
},

{
scene:"日常",
en:"Where are you going?",
cn:"你要去哪里？",
audio:"004.mp3"
},

{
scene:"日常",
en:"Where do you live?",
cn:"你住在哪里？",
audio:"005.mp3"
}

];


let current = 0;

const player =
document.getElementById("player");

const status =
document.getElementById("status");


/* =========================
   显示句子
========================= */

function showSentence(){

const item =
lessons[current];

document.getElementById("scene")
.innerText =
item.scene;

document.getElementById("english")
.innerText =
item.en;

document.getElementById("chinese")
.innerText =
item.cn;

document.getElementById("progress")
.innerText =
"第 " +
(current + 1) +
" / " +
lessons.length +
" 句";

}


/* =========================
   播放MP3
========================= */

function playCurrent(){

player.pause();

player.currentTime = 0;

const item =
lessons[current];

player.src =
"audio/" + item.audio;

player.load();

status.innerText =
"🎧 正在加载 " +
item.audio;

player.play()

.then(function(){

status.innerText =
"🎧 正在播放……";

})

.catch(function(){

status.innerText =
"❌ 播放失败：" +
item.audio;

});

}


/* =========================
   重听
========================= */

function repeatCurrent(){

if(!player.src){

playCurrent();

return;

}

player.currentTime = 0;

player.play()

.then(function(){

status.innerText =
"🔁 重听中……";

})

.catch(function(){

playCurrent();

});

}


/* =========================
   下一句
========================= */

function nextSentence(){

player.pause();

player.removeAttribute("src");

player.load();

current++;

if(current >= lessons.length){

current = 0;

}

showSentence();

status.innerText =
"准备好了";

}


/* =========================
   上一句
========================= */

function previousSentence(){

player.pause();

player.removeAttribute("src");

player.load();

current--;

if(current < 0){

current =
lessons.length - 1;

}

showSentence();

status.innerText =
"准备好了";

}


/* =========================
   随机
========================= */

function randomSentence(){

player.pause();

player.removeAttribute("src");

player.load();

current =
Math.floor(
Math.random() *
lessons.length
);

showSentence();

status.innerText =
"🎲 已随机选择";

}


/* =========================
   搜索
========================= */

function searchSentence(){

const input =
document.getElementById(
"searchInput"
);

const keyword =
input.value
.trim()
.toLowerCase();

const results =
document.getElementById(
"results"
);

results.innerHTML = "";

if(!keyword){

return;

}

lessons.forEach(
function(item,index){

if(

item.en
.toLowerCase()
.includes(keyword)

||

item.cn
.includes(keyword)

||

item.scene
.includes(keyword)

){

const box =
document.createElement(
"div"
);

box.className =
"result";

box.innerHTML =

"<div class='result-en'>" +
item.en +
"</div>" +

"<div class='result-cn'>" +
item.cn +
"</div>";

box.onclick =
function(){

player.pause();

player.removeAttribute(
"src"
);

player.load();

current =
index;

showSentence();

results.innerHTML =
"";

input.value =
"";

};

results.appendChild(box);

}

});

}


/* =========================
   回车搜索
========================= */

document
.getElementById("searchInput")
.addEventListener(
"keydown",
function(event){

if(event.key === "Enter"){

searchSentence();

}

});


/* =========================
   播放状态
========================= */

player.addEventListener(
"playing",
function(){

status.innerText =
"🎧 正在播放……";

});


player.addEventListener(
"waiting",
function(){

status.innerText =
"⏳ 正在缓冲……";

});


player.addEventListener(
"ended",
function(){

status.innerText =
"✅ 播放完成";

});


player.addEventListener(
"error",
function(){

status.innerText =
"❌ 找不到 MP3 文件";

});


/* =========================
   启动
========================= */

showSentence();

</script>

</body>
</html>